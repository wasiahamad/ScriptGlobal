                {
                  "key": "sort",
                  "value": "createdAt"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          },
          "response": [
            {
              "name": "200 Published records",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": [],\n  \"pagination\": { \"page\": 1, \"limit\": 20, \"total\": 0, \"totalPages\": 0 }\n}"
            }
          ]
        },
        {
          "name": "GET Public collection record",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/public/{{resource}}/{{slug}}"
