{
  "info": {
    "name": "SciScript API",
    "description": "Complete request and response collection for the SciScript API. Set baseUrl to http://localhost:8000. Login stores the HTTP-only auth cookies automatically in Postman. Collection variables resource and singleton cover every mounted content route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "resource",
      "value": "services",
      "description": "services, expertise, research, publications, projects, scientific-visuals, faqs, testimonials, navigation, seo"
    },
    {
      "key": "singleton",
      "value": "home",
      "description": "home, profile, thesis, editing, publication-support, peer-review, research-integrity, footer, contact, settings"
    },
    {
      "key": "id",
      "value": "replace-with-mongodb-id"
    },
    {
      "key": "slug",
      "value": "replace-with-slug"
    },
    {
      "key": "token",
      "value": "replace-with-reset-token"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": { \"status\": \"ok\" }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "response": [
            {
              "name": "200 Logged in",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": { \"user\": { \"name\": \"Admin\", \"email\": \"admin@example.com\", \"role\": \"super_admin\" } }\n}"
            },
            {
              "name": "401 Invalid credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid credentials\"\n}"
            }
          ]
        },
        {
          "name": "POST Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          },
          "response": [
            {
              "name": "200 Logged out",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Logout successful\",\n  \"data\": null\n}"
            }
          ]
        },
        {
          "name": "POST Refresh access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "response": [
            {
              "name": "200 Refreshed",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Token refreshed\",\n  \"data\": null\n}"
            }
          ]
        },
        {
          "name": "GET Current admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "response": [
            {
              "name": "200 Current user",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": { \"id\": \"...\", \"name\": \"Admin\", \"email\": \"admin@example.com\", \"role\": \"super_admin\" }\n}"
            }
          ]
        },
        {
          "name": "POST Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          },
          "response": [
            {
              "name": "200 Request accepted",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"If an account exists, reset instructions have been sent\",\n  \"data\": null\n}"
            }
          ]
        },
        {
          "name": "POST Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"password\": \"NewPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          },
          "response": [
            {
              "name": "200 Password reset",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Password reset successful\",\n  \"data\": null\n}"
            },
            {
              "name": "400 Invalid token",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid or expired token\"\n}"
            }
          ]
        }
      ]
    },
    {
